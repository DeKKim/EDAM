# Copy this file to ".env" and fill in the keys you have.
# Any key left blank simply disables that enrichment phase — the scan still runs.

# Shodan: host/service enrichment (open ports, banners, org/ISP, geo)
VITE_SHODAN_API_KEY=

# Censys: additional passive subdomain discovery (needs both ID and secret)
VITE_CENSYS_API_ID=
VITE_CENSYS_API_SECRET=

# GreyHatWarfare: possible exposed cloud bucket discovery
VITE_GREYHAT_API_KEY=
